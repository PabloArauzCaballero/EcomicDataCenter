# ─────────────────────────────────────────────────────────────
# Observatorio Económico Core — .gitignore
# Stack: NestJS 11 + Fastify · TypeScript · Sequelize/PG · Yarn 1.22.22
#         Python (gates quality:*) · Docker · Jest
# ─────────────────────────────────────────────────────────────

# ── Dependencias ─────────────────────────────────────────────
node_modules/
jspm_packages/
web_modules/

# Yarn 1 (Classic). El lockfile SÍ se versiona (yarn.lock).
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
yarn-error.log
npm-debug.log*
yarn-debug.log*

# ── Build / compilación ──────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo
.tsbuildinfo

# ── Variables de entorno y secretos ──────────────────────────
# .env* nunca se versiona; solo el ejemplo público.
.env
.env.*
!.env.example
# Credencial del colector de ChatGPT. Ya cubierto por `.env.*`; se declara
# aparte para que quede explícito que contiene un secreto en claro.
.env.chatgpt
*.pem
*.key
*.p12
*.pfx
secrets/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
pids/
*.pid
*.seed

# ── Pruebas y cobertura ──────────────────────────────────────
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/

# ── Artefactos generados (scripts de calidad/operación) ──────
artifacts/
!artifacts/.gitkeep
**/smoke-results*.json
**/stress-results*.json
**/load-results*.json
**/audit-results*.json

# ── Base de datos: dumps y respaldos (nunca versionar) ───────
backups/
*.dump
*.backup
*.sql.gz
*.sqlite
*.sqlite3

# ── Python (gates quality:* / validadores) ───────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ── Graphify (knowledge graph; caché regenerable) ────────────
graphify-out/cache/

# ── Herramientas / caché de linters ──────────────────────────
.eslintcache
.cache/
.prettiercache

# ── Docker (overrides locales) ───────────────────────────────
docker-compose.override.yml

# ── Editores / IDE ───────────────────────────────────────────
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ── Sistema operativo ────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Temporales ───────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
